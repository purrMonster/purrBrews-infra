## Rendered by ../../render-configs.sh from this .template — edit the
## .template, never the rendered dynamic.yml (it gets overwritten).
##
## File-provider routes live here; most app routes instead use Docker
## labels (see e.g. authelia/docker-compose.yml) so they travel with their
## own compose file. This is for routes with no container of their own to
## hang labels off of: Traefik's own dashboard, and (added 2026-08-29)
## Pi-hole's admin UI — Pi-hole needs network_mode: host for real DNS
## traffic, which means it isn't on sieve_proxy and Traefik's docker-label
## discovery can't see it, same reasoning as the dashboard.

# force-http1 (added 2026-09-10): Traefik only recognizes the literal
# `Upgrade: websocket` header value for its connection-upgrade passthrough
# (confirmed via traefik/traefik#12609) -- headscale's TS2021 control
# protocol sends `Upgrade: tailscale-control-protocol` instead, which
# Traefik doesn't special-case, so it silently negotiates HTTP/2 with the
# client via ALPN and the upgrade semantics never reach headscale (logged
# there as "No Upgrade header in TS2021 request"). Forcing ALPN to
# http/1.1 for headscale's router specifically avoids the downgrade.
# Referenced from headscale/docker-compose.yml's router label via the
# @file suffix -- TLS options can't be set via Docker labels themselves,
# only referenced from there (Traefik docs are explicit on this).
tls:
  options:
    force-http1:
      alpnProtocols:
        - "http/1.1"

http:
  routers:
    traefik-dashboard:
      rule: "Host(`traefik.${DOMAIN}`)"
      entrypoints:
        - websecure
      service: api@internal
      # Cross-provider reference: this middleware is defined via Docker
      # labels on the authelia service, hence the @docker suffix.
      middlewares:
        - authelia@docker
    pihole:
      rule: "Host(`pihole.${DOMAIN}`)"
      entrypoints:
        - websecure
      service: pihole
      # Pi-hole's own password is disabled (see pihole/docker-compose.yml)
      # — this middleware is the ONLY thing standing between the LAN and an
      # unauthenticated Pi-hole admin panel. Not optional here.
      middlewares:
        - authelia@docker
  services:
    pihole:
      loadBalancer:
        servers:
          # host.docker.internal resolves via the extra_hosts entry in
          # traefik/docker-compose.yml — see that file's comment.
          - url: "http://host.docker.internal:8080"
