http:
  middlewares:
    authelia:
      forwardAuth:
        # Confirmed 2026-09-03 via Authelia's own current Traefik
        # integration docs: /api/authz/forward-auth is the modern "authz"
        # endpoint (superseding the older /api/verify). This has to be a
        # real routable address, not a Docker network alias -- Authelia
        # runs on sieve, a different physical host, so Docker's own
        # service discovery can't reach it.
        #
        # FIXED 2026-09-04, before this was ever brought up for real:
        # the previous address, http://${SIEVE_LAN_IP}:9091/..., pointed
        # at a port sieve's Authelia never actually publishes to its own
        # host (see stacks/sieve/authelia/docker-compose.yml -- it only
        # joins sieve's internal sieve_proxy Docker network). Caught when
        # silo's identical copy of this same address returned an
        # immediate empty 500 on its first real test -- silo's template
        # got the same fix, see its own comment for the full story.
        # Routes through sieve's own Traefik instead (already publishes
        # 443 with a real ACME cert, already routes authelia.${DOMAIN} to
        # the Authelia container -- the same path browsers already use to
        # log in). Requires authelia.${DOMAIN} to resolve from percolator,
        # same as every other *.${DOMAIN} hostname this fleet depends on.
        address: "https://authelia.${DOMAIN}/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Email
          - Remote-Name
