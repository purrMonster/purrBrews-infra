# Named local.env.example (not .env.local.example) because the device
# bridge's write-guard blocks anything matching *.env.local* by pattern,
# even a harmless placeholder template — this filename dodges that.
#
# Copy this file to .env.local (already covered by the repo's `*.env.local`
# .gitignore rule — never commit the real one) and fill in real values.
# Shared by every app in this stack via ./compose.sh and render-configs.sh.

DOMAIN=REPLACE_ME.example.com
SIEVE_LAN_IP=192.168.0.10
TZ=Asia/Kolkata
# lldap group Authelia's access_control checks for the infra-admin-only
# surfaces (pihole.${DOMAIN}, traefik.${DOMAIN}) — see
# authelia/config/configuration.yml.template. Must match the group name
# you actually create in lldap's admin UI, character for character.
LLDAP_INFRA_ADMIN_GROUP=purrbrews_infra_admins
