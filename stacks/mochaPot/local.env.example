# Named local.env.example (not .env.local.example) — same device-bridge
# write-guard workaround as stacks/sieve/local.env.example and
# stacks/silo/local.env.example (anything matching *.env.local* gets
# blocked, even a harmless placeholder).
#
# Copy this file to .env.local (already covered by this repo's
# `*.env.local` .gitignore rule — never commit the real one) and fill in
# real values. Shared by every app in this stack via ./compose.sh and
# render-configs.sh.
#
# Deliberately minimal — added 2026-09-01 when mochaPot's stack directory
# was first scaffolded, before mochaPot has any apps of its own. Only the
# facts every node needs regardless of what gets built on it. As apps get
# added here (see stacks/silo/local.env.example for what that growth looks
# like — SIEVE_LAN_IP, SILO_LAN_INTERFACE/SUBNET, etc., each added exactly
# when the app that needed it was built, never speculatively), add their
# REPLACE_ME values to this file the same way, not before.

MOCHAPOT_LAN_IP=REPLACE_ME
# Needed 2026-09-04 for komodo-periphery/docker-compose.yml's
# PERIPHERY_CORE_ADDRESS (ws://${SILO_LAN_IP}:9120) so silo's Komodo
# Core can manage mochaPot's containers too -- same value, same
# reasoning as percolator's/cellar's/sieve's own SILO_LAN_IP. Confirm
# it matches stacks/silo/.env.local's own SILO_LAN_IP exactly.
SILO_LAN_IP=REPLACE_ME
# Added 2026-09-05 for scrutiny-collector/docker-compose.yml -- REAL
# device path, confirmed on mochaPot itself via
#   lsblk -d -o NAME,TYPE,SIZE,MODEL
# before filling this in. mochaPot has one physical disk per
# initiation.txt (512GB NVMe) -- use the controller node (/dev/nvme0),
# NOT the namespace block device (/dev/nvme0n1).
MOCHAPOT_DISK_DEVICE_NVME=REPLACE_ME
TZ=Asia/Kolkata
# Jellyfin's Intel Quick Sync passthrough (jellyfin/docker-compose.yml) --
# find the real value ON mochaPot with:
#   getent group render | cut -d: -f3
MOCHAPOT_RENDER_GID=REPLACE_ME
# PERCOLATOR_LAN_IP removed 2026-09-05 -- immich/docker-compose.yml no
# longer reaches across the LAN for its database at all. Immich's own
# Postgres+VectorChord and Valkey now run colocated in that same compose
# file, on this node, reached by container name. See the runbook's
# 2026-09-05 entry for why (a port collision on percolator, plus a
# deliberate call to grow mochaPot's own storage instead of continuing
# to expose database ports across the LAN).
#
# roastery's Headscale tailnet IP -- needed 2026-09-03 for
# immich/docker-compose.yml's ML worker endpoint. roastery's own Immich
# ML worker isn't built/running yet (per initiation.txt, it's
# Ollama + GPU-accelerated ML, reachable only via the tailnet, no public
# exposure) -- Immich runs fine without this filled in, just skips ML
# inference until it is.
# Same real domain as every other node's local.env.example DOMAIN — only
# actually needed once some app on mochaPot links to another node's
# service (homepage-style) or gets routed through Traefik. Kept here from
# the start anyway since every other stack in this fleet has it and an app
# added later shouldn't require a template-file change just to gain it.
DOMAIN=REPLACE_ME.example.com
