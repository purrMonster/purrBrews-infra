http:
  middlewares:
    authelia:
      forwardAuth:
        # Confirmed 2026-09-03 via Authelia's own current Traefik
        # integration docs: /api/authz/forward-auth is the modern "authz"
        # endpoint (superseding the older /api/verify). This has to be a
        # direct hop to Authelia's own port, not routed through sieve's
        # public Traefik -- tried that first 2026-09-04 for silo's
        # identical copy of this address, wrong: Authelia's own logs
        # showed `error="header 'X-Forwarded-Method' is empty"` on the
        # first real cross-host test. ForwardAuth depends on
        # X-Forwarded-Method/Proto/Host/Uri describing the ORIGINAL
        # request being authorized, set by THIS Traefik -- routing
        # through a second, unrelated Traefik hop drops headers like
        # X-Forwarded-Method that aren't standard reverse-proxy headers.
        # A direct hop is required; there's no way around it.
        #
        # sieve's Authelia now publishes 9091 to its own host for exactly
        # this reason (see stacks/sieve/authelia/docker-compose.yml's own
        # comment for the full story, including why this exception is
        # lower-stakes than Komodo's 9120 one). ${SIEVE_LAN_IP} comes
        # from .env.local, same value silo's own unbound access-
        # control.conf already depends on.
        address: "http://${SIEVE_LAN_IP}:9091/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Email
          - Remote-Name
