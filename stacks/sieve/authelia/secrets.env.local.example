# Auto-generated by ../generate-secrets.sh — this .example file is
# documentation only; the real secrets.env.local is gitignored.
# AUTHELIA_LDAP_PASSWORD mirrors lldap/secrets.env.local's
# LLDAP_ADMIN_PASSWORD — the script copies it, don't set it independently.
AUTHELIA_LDAP_PASSWORD=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# Signs reset-password link tokens — required by Authelia as soon as
# reset_password isn't explicitly disabled (added 2026-08-30, first
# bring-up crashed without it: "option 'jwt_secret' is required").
AUTHELIA_RESET_PASSWORD_JWT_SECRET=
REDIS_PASSWORD=

# --- OIDC provider (added 2026-09-06) -------------------------------------
# hmac_secret signs/verifies Authelia's own OIDC tokens -- random,
# generated by generate-secrets.sh, same as the values above.
AUTHELIA_OIDC_HMAC_SECRET=
# One PLAINTEXT + one HASHED (pbkdf2-sha512) secret per OIDC client app,
# generated together by generate-secrets.sh's "OIDC clients" section --
# the plaintext is what gets copied to that app's OWN secrets.env.local on
# its own node (Authelia and the app almost never share a node); the hash
# is what stays here, in configuration.yml.template's client_secret field.
# Headscale is the one exception -- same node as Authelia, so its
# plaintext lands directly in ../headscale/secrets.env.local, no copying
# needed.
VIKUNJA_OIDC_CLIENT_SECRET=
VIKUNJA_OIDC_CLIENT_SECRET_HASH=
MEALIE_OIDC_CLIENT_SECRET=
MEALIE_OIDC_CLIENT_SECRET_HASH=
IMMICH_OIDC_CLIENT_SECRET=
IMMICH_OIDC_CLIENT_SECRET_HASH=
FRESHRSS_OIDC_CLIENT_SECRET=
FRESHRSS_OIDC_CLIENT_SECRET_HASH=
ACTUALBUDGET_OIDC_CLIENT_SECRET=
ACTUALBUDGET_OIDC_CLIENT_SECRET_HASH=
NEXTCLOUD_OIDC_CLIENT_SECRET=
NEXTCLOUD_OIDC_CLIENT_SECRET_HASH=
PAPERLESS_OIDC_CLIENT_SECRET=
PAPERLESS_OIDC_CLIENT_SECRET_HASH=
HOMEASSISTANT_OIDC_CLIENT_SECRET=
HOMEASSISTANT_OIDC_CLIENT_SECRET_HASH=
VAULTWARDEN_OIDC_CLIENT_SECRET=
VAULTWARDEN_OIDC_CLIENT_SECRET_HASH=
KOMODO_OIDC_CLIENT_SECRET=
KOMODO_OIDC_CLIENT_SECRET_HASH=
HEADSCALE_OIDC_CLIENT_SECRET=
HEADSCALE_OIDC_CLIENT_SECRET_HASH=
JELLYFIN_OIDC_CLIENT_SECRET=
JELLYFIN_OIDC_CLIENT_SECRET_HASH=
