## Rendered by ../../render-configs.sh from this .template -- edit the
## .template, never the rendered dynamic.yml (it gets overwritten).
##
## Gates silo's fleet-ops UIs behind sieve's Authelia, same ForwardAuth
## pattern as sieve's own dynamic.yml.template (Pi-hole) and percolator's
## traefik/config/dynamic.yml.template. Added 2026-09-04 -- silo was the
## biggest gap in this fleet's SSO-gating story: Komodo has effective root
## on every node running a Periphery agent, and it (plus Scrutiny/
## NetAlertX/Homepage/Speedtest-tracker) was sitting on a raw, ungated
## port while sieve gates even its own Traefik dashboard. This closes that.
##
## Routing is by Host() header for disambiguation (one Traefik entrypoint,
## five apps), with backends reached over silo_net by container name --
## changed 2026-09-04 from the original ${SILO_LAN_IP}:<published-port>
## design, same day, before ever bringing this up for real: Docker's own
## iptables DNAT for those published ports turned out to bypass ufw
## entirely (confirmed on Komodo's port -- see the runbook's 2026-09-04
## entry), which meant a ufw rule "restricting" any of them was a no-op.
## Komodo/Scrutiny/Homepage/Speedtest-tracker had their ports: mappings
## removed entirely as part of the same fix (see each app's own
## docker-compose.yml) -- this is now their ONLY path in, not a parallel
## one. NetAlertX is the one exception, still reached via ${SILO_LAN_IP}
## -- network_mode: host can't join silo_net, and isn't subject to the
## same ufw-bypass issue in the first place (host networking binds
## directly to the host's real network stack, no Docker NAT involved).
##
## These Host() rules need komodo.${DOMAIN} / scrutiny.${DOMAIN} / etc.
## to actually resolve to ${SILO_LAN_IP} on the LAN. No public DNS record
## should exist for these (this is plain HTTP, no ACME, LAN-only, unlike
## sieve's real subdomains) -- add them as Local DNS Records in sieve's
## own Pi-hole admin UI instead (Settings -> Local DNS Records, or
## /etc/pihole/custom.list directly), pointing each hostname at
## ${SILO_LAN_IP}. Confirmed 2026-09-04 this is the right layer, not
## silo's own Unbound -- Unbound here is Pi-hole's upstream recursive
## resolver, access-restricted to accept queries from sieve alone (see
## unbound/local.env.example's own comment), not something client devices
## query directly. Pi-hole is the actual household resolver (README:
## "everything else depends on local name resolution", DHCP meant to be
## enabled there later) -- that's where local overrides belong. Not added
## here since it's a change on sieve, not this directory. Until it's
## added, test with:
##   curl -H "Host: komodo.${DOMAIN}" http://${SILO_LAN_IP}/

http:
  middlewares:
    authelia:
      forwardAuth:
        # FIXED 2026-09-04, after silo's Traefik went live for real and
        # this returned an immediate empty 500 on every request: the
        # previous address, http://${SIEVE_LAN_IP}:9091/..., pointed at a
        # port sieve's Authelia never actually publishes to its own host
        # at all (see stacks/sieve/authelia/docker-compose.yml -- it only
        # joins the internal sieve_proxy Docker network, reachable by
        # container name to sieve's own Traefik, nothing more). That
        # address had never been exercised anywhere in this fleet before
        # tonight -- percolator's identical copy is still dormant, never
        # brought up -- so the bug went unnoticed since the template was
        # first written.
        #
        # Fixed by routing through sieve's own Traefik instead, the same
        # path browsers already use to reach Authelia's login portal:
        # sieve's Traefik publishes 443 with a real ACME cert and already
        # routes authelia.${DOMAIN} to the Authelia container (see
        # stacks/sieve/authelia/docker-compose.yml's own Traefik labels).
        # Reuses infrastructure already proven working rather than
        # opening a second raw port on sieve (which would've meant yet
        # another Docker-NAT-bypasses-ufw exposure, same category as
        # Komodo's 9120 exception on silo). Requires authelia.${DOMAIN} to
        # actually resolve from silo -- true as long as silo's own DNS
        # points at sieve's Pi-hole, same as every other *.${DOMAIN}
        # hostname this fleet depends on; not independently re-confirmed
        # here, flagging rather than asserting.
        address: "https://authelia.${DOMAIN}/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Email
          - Remote-Name

  routers:
    komodo:
      # Highest-priority app to gate on this node -- Komodo's Periphery
      # agent has unrestricted docker.sock access on every node it's
      # deployed to (see komodo/docker-compose.yml's own comment).
      # Whoever controls this UI effectively has root on the fleet.
      rule: "Host(`komodo.${DOMAIN}`)"
      entrypoints: [web]
      service: komodo
      middlewares: [authelia]
    scrutiny:
      rule: "Host(`scrutiny.${DOMAIN}`)"
      entrypoints: [web]
      service: scrutiny
      middlewares: [authelia]
    netalertx:
      # NetAlertX has its own login (SETPWD_password, see its own
      # docker-compose.yml comment) -- this is a second layer, same
      # reasoning as gating Vaultwarden's admin path would be, not a
      # replacement for it. Kept for consistency: every silo UI gets the
      # same treatment rather than picking and choosing.
      rule: "Host(`netalertx.${DOMAIN}`)"
      entrypoints: [web]
      service: netalertx
      middlewares: [authelia]
    homepage:
      # Homepage is a dashboard that links out to the others -- gating it
      # too, not just the apps it links to, since it's reachable on its
      # own raw port regardless.
      rule: "Host(`homepage.${DOMAIN}`)"
      entrypoints: [web]
      service: homepage
      middlewares: [authelia]
    speedtest-tracker:
      rule: "Host(`speedtest.${DOMAIN}`)"
      entrypoints: [web]
      service: speedtest-tracker
      middlewares: [authelia]

  services:
    # Container-DNS backends, changed 2026-09-04 (were all
    # ${SILO_LAN_IP}:<published-port> originally -- see the runbook's
    # same-day entry for why: Docker's own iptables DNAT for those
    # published ports bypassed ufw entirely, so those ports got
    # unpublished from every app below except netalertx, and Traefik
    # joined silo_net to reach them by name instead). Each backend's port
    # is the CONTAINER's own internal port, not the old host-side publish
    # (e.g. scrutiny is 8080 here, not the old host-side 8081).
    komodo:
      loadBalancer:
        servers:
          - url: "http://komodo-core:9120"
    scrutiny:
      loadBalancer:
        servers:
          - url: "http://scrutiny:8080"
    netalertx:
      # Still LAN-IP-based, deliberately -- network_mode: host means it
      # can't join silo_net, same structural exception as sieve's
      # Pi-hole/percolator's Home Assistant. Its raw port (20211) stays
      # published and ufw-governed correctly (host networking isn't
      # subject to the Docker-NAT-bypasses-ufw issue the other four had).
      loadBalancer:
        servers:
          - url: "http://${SILO_LAN_IP}:20211"
    homepage:
      loadBalancer:
        servers:
          - url: "http://homepage:3000"
    speedtest-tracker:
      loadBalancer:
        servers:
          - url: "http://speedtest-tracker:80"

# Deliberately NOT routed here: Diun (no web UI at all -- notification-
# only) and Unbound/CrowdSec/the plain "speedtest" data-source container
# (no web UI of their own either). Nothing to gate for those.
