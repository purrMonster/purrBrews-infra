# Named local.env.example (not .env.local.example) — same device-bridge
# write-guard workaround as stacks/sieve/local.env.example and
# stacks/silo/local.env.example (anything matching *.env.local* gets
# blocked, even a harmless placeholder).
#
# Copy this file to .env.local (already covered by this repo's
# `*.env.local` .gitignore rule — never commit the real one) and fill in
# real values. Shared by every app in this stack via ./compose.sh and
# render-configs.sh.
#
# Deliberately minimal — added 2026-09-01 when cellar's stack directory
# was first scaffolded, before cellar has any apps of its own. Only the
# facts every node needs regardless of what gets built on it. As apps get
# added here (see stacks/silo/local.env.example for what that growth looks
# like — SIEVE_LAN_IP, SILO_LAN_INTERFACE/SUBNET, etc., each added exactly
# when the app that needed it was built, never speculatively), add their
# REPLACE_ME values to this file the same way, not before.

CELLAR_LAN_IP=REPLACE_ME
# Needed once cellar runs a Komodo Periphery agent (see
# komodo-periphery/docker-compose.yml, added 2026-09-04) so it knows
# where silo's Komodo Core is (ws://${SILO_LAN_IP}:9120) -- same value
# as silo's own SILO_LAN_IP in stacks/silo/local.env.example, just
# copied here since each node's .env.local is independent.
SILO_LAN_IP=REPLACE_ME
# Confirmed via `lsblk` on cellar itself, 2026-09-05 -- does NOT match
# initiation.txt's documented "256GB NVMe + 1TB HDD": real hardware is a
# 238.5G disk (sda, boots the OS) and a 476.9G NVMe (nvme0n1, mounted at
# /media/storage) -- no HDD found. For the NVMe, use the controller node
# (/dev/nvme0), not the namespace block device lsblk shows (/dev/nvme0n1).
CELLAR_DISK_DEVICE_SDA=/dev/sda
CELLAR_DISK_DEVICE_NVME0=/dev/nvme0
TZ=Asia/Kolkata
# Same real domain as every other node's local.env.example DOMAIN — only
# actually needed once some app on cellar links to another node's
# service (homepage-style) or gets routed through Traefik. Kept here from
# the start anyway since every other stack in this fleet has it and an app
# added later shouldn't require a template-file change just to gain it.
DOMAIN=REPLACE_ME.example.com
