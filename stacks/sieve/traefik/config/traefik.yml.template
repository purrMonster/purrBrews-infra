## Rendered by ../../render-configs.sh from this .template — edit the
## .template, never the rendered traefik.yml (it gets overwritten).

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: cloudflare

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: sieve_proxy
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  cloudflare:
    acme:
      email: admin@${DOMAIN}
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"

api:
  dashboard: true

log:
  level: INFO

# JSON access log, added 2026-09-01 for crowdsec/crowdsecurity/traefik to
# read (see ../../crowdsec/config/acquis.yaml.template) — Traefik's own
# `log:` above is its internal process log, unrelated to this. No
# `filters:` block, deliberately: logging every status code (not just
# 4xx/5xx) so scenarios that key off request patterns rather than status
# still have something to match against. Revisit if disk usage on
# /srv/data/traefik/logs ever becomes a problem — no logrotate is set up
# for this file yet (backlog).
accessLog:
  filePath: /var/log/traefik/access.log
  format: json
