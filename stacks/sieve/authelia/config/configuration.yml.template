---
# Rendered by ../../render-configs.sh from this .template — edit the
# .template, never the rendered configuration.yml (it gets overwritten).
#
# Deliberately minimal for first bring-up: one_factor everywhere (no TOTP
# enrollment required yet), filesystem notifier (no SMTP dependency yet).
# Tighten access_control to two_factor once TOTP is confirmed working —
# see stacks/sieve/README.md.

theme: light

server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: info

authentication_backend:
  ldap:
    # 'lldap' is a first-class implementation preset in Authelia (not just
    # "custom LDAP that happens to be lldap") — it fills in the users/groups
    # search filters and attribute mappings (uid, mail, displayName,
    # memberOf, etc.) that match lldap's actual schema. Without this,
    # Authelia treats the backend as fully generic and refuses to start
    # until users_filter/groups_filter are supplied by hand — that's the
    # "option 'users_filter' is required" / "'groups_filter' is required"
    # fatal errors seen on first bring-up (2026-08-30).
    implementation: 'lldap'
    address: 'ldap://lldap:3890'
    base_dn: 'dc=purrbrews,dc=internal'
    additional_users_dn: 'ou=people'
    additional_groups_dn: 'ou=groups'
    user: 'uid=admin,ou=people,dc=purrbrews,dc=internal'
    password: '${AUTHELIA_LDAP_PASSWORD}'

# Authelia's reset-password email/link flow signs its tokens with this
# secret — required as soon as reset_password isn't explicitly disabled
# (it isn't here, filesystem notifier still writes the link to a file),
# same "fatal until set" behavior seen alongside the LDAP errors above.
# Generated by generate-secrets.sh into authelia/secrets.env.local, same
# pattern as AUTHELIA_SESSION_SECRET/AUTHELIA_STORAGE_ENCRYPTION_KEY.
identity_validation:
  reset_password:
    jwt_secret: '${AUTHELIA_RESET_PASSWORD_JWT_SECRET}'

access_control:
  default_policy: deny
  rules:
    # Infra-admin surfaces — restricted to the purrbrews_infra_admins lldap
    # group (currently just barista), not merely "any logged-in user".
    # Decided 2026-08-30 alongside the barista/penguin/bubbles identity
    # model — see stacks/sieve/README.md and runbook.md. Rules are matched
    # top-to-bottom, first match wins, so these two must stay above the
    # catch-all below.
    - domain: 'pihole.${DOMAIN}'
      subject:
        - 'group:purrbrews_infra_admins'
      policy: one_factor
    - domain: 'traefik.${DOMAIN}'
      subject:
        - 'group:purrbrews_infra_admins'
      policy: one_factor
    # Catch-all for everything else: any authenticated lldap user, no group
    # restriction. Nothing lives here yet (penguin/bubbles don't exist as
    # lldap accounts until created later), but this is what headscale and
    # future services will fall under unless given their own admin-only
    # rule above.
    - domain: '*.${DOMAIN}'
      policy: one_factor

session:
  secret: '${AUTHELIA_SESSION_SECRET}'
  cookies:
    - domain: '${DOMAIN}'
      authelia_url: 'https://authelia.${DOMAIN}'
      default_redirection_url: 'https://${DOMAIN}'
  redis:
    host: redis
    port: 6379
    password: '${REDIS_PASSWORD}'

regulation:
  max_retries: 5
  find_time: 2m
  ban_time: 5m

storage:
  encryption_key: '${AUTHELIA_STORAGE_ENCRYPTION_KEY}'
  local:
    path: '/config/db.sqlite3'

notifier:
  # Filesystem notifier for now — password-reset/registration links land in
  # this file inside the container (docker exec in and cat it, or bind-mount
  # it out) rather than being emailed. Switch to an smtp: block once you
  # have a mail sender you're happy to use.
  disable_startup_check: false
  filesystem:
    filename: '/config/notification.txt'
