# Restricts this resolver to exactly one client: sieve's Pi-hole.
#
# The base image's own default config (klutchell/unbound-docker,
# rootfs_overlay/etc/unbound/unbound.conf — read directly from source
# 2026-08-31, after the first fix attempt below still failed) ships:
#   access-control: 127.0.0.0/8    allow   (localhost)
#   access-control: 192.168.0.0/16 allow   (our whole LAN, and then some)
#   access-control: 172.16.0.0/12  allow   (includes Docker's own default
#                                           bridge-network ranges)
#   access-control: 10.0.0.0/8     allow
#
# SECOND correction, 2026-08-31: the first fix here (`0.0.0.0/0 refuse`
# plus sieve's `/32 allow`) still failed the real test — an unrelated LAN
# device still got a normal answer. Root cause: the base's broad allow is
# at /16, not /0 — a /0 refuse is LESS specific than a /16 allow, so per
# Unbound's own documented matching rule ("the most specific netblock
# match is used ... the order of the access-control statements therefore
# does not matter" — confirmed against Unbound's own manpage this time,
# not assumed a second time), the base's /16 allow always won regardless
# of what a /0 rule said. A same-prefix override (/16 refuse fighting the
# base's /16 allow) was considered instead, but Unbound's docs explicitly
# don't define a tie-break for two EQUALLY specific entries — not
# something to build a security boundary on.
#
# This version refuses at 192.168.0.0/24 instead — our actual LAN, more
# specific than the base's /16 allow, so "most specific always wins,
# order doesn't matter" applies with no ambiguity. Sieve's own /32 allow
# is more specific still, so it wins over this refuse the same
# unambiguous way.
server:
  access-control: 192.168.0.0/24 refuse
  access-control: ${SIEVE_LAN_IP}/32 allow

  # Best-effort only, for the two other ranges the base allows —
  # 172.16.0.0/12 (includes Docker's own default bridge-network ranges)
  # and 10.0.0.0/8. Refused at the SAME prefix length the base grants
  # them, which per the tie-break ambiguity above isn't guaranteed to
  # win. No device on this network actually lives in either range, so
  # the realistic exposure is narrow — would need code execution inside
  # a container on silo itself to matter, not "any device on the LAN"
  # like the /24 case above. Tracked in the runbook backlog to verify
  # for real rather than left assumed a third time.
  access-control: 172.16.0.0/12 refuse
  access-control: 10.0.0.0/8 refuse

  # 127.0.0.0/8 (localhost) deliberately left as the base allows it —
  # that's silo itself, not the open-LAN exposure this file exists to
  # close.
  #
  # No IPv6 access-control needed: the base config's only `interface:`
  # line is `0.0.0.0` (IPv4), no `::0` — Unbound isn't listening on any
  # IPv6 address at all here, so there's nothing for an IPv6 client to
  # reach regardless of access-control.
