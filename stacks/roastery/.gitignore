# Rendered by render-configs.sh from *.template files, and generated by
# generate-secrets.sh — both contain the real domain and/or real secrets.
# The *.template / *.example files are the tracked source of truth; these
# are always regeneratable, never hand-edit them directly.
.env.local
*/secrets.env.local
*/config/*
!*/config/*.template

# immich-ml's downloaded ONNX model files -- large binaries, always
# re-downloadable from Immich's own model repo on first run, never meant
# to be committed. Added 2026-09-05 alongside immich-ml itself.
immich-ml/model-cache/*

# Jellyfin's cache dir -- transcode scratch space, never meant to be
# committed. (jellyfin/config/* is already covered by the generic
# */config/* rule above -- this line only adds what that rule doesn't.)
# Added 2026-09-05 when Jellyfin moved here from mochaPot.
jellyfin/cache/*
