# Restricts this resolver to exactly one client: sieve's Pi-hole.
#
# CORRECTED 2026-08-31, on first real bring-up: the original version of
# this file shipped only the specific `allow` line below, reasoning that
# Unbound's longest-prefix-match would make a /32 win over whatever
# broader rule the base image's default config already had. That
# reasoning was incomplete — longest-prefix-match only decides what
# happens for traffic that actually MATCHES the more specific rule
# (sieve's own traffic); it does nothing to restrict every OTHER source
# IP, which stayed governed entirely by the base default's own rules.
# First real test caught this: querying from an unrelated LAN device (not
# sieve) got a normal NOERROR answer instead of REFUSED — an open
# resolver reachable by anyone on the LAN, exactly the abuse vector this
# file was supposed to prevent.
#
# Fixed by adding an explicit deny-everyone-by-default rule alongside the
# specific allow. For two access-control entries at the same specificity
# (both 0.0.0.0/0 here), Unbound resolves by load order — last one wins —
# and custom.conf.d files load after the base config, so this `refuse`
# line overrides whatever the base default's own 0.0.0.0/0 rule was,
# regardless of what it actually was. The more-specific /32 `allow` for
# sieve still wins over both via longest-prefix-match — that part of the
# original reasoning held up fine, it just wasn't sufficient on its own.
#
# access-control only governs who's allowed to QUERY this resolver — it
# has no effect on Unbound's own outbound recursive lookups to root
# servers, so this can't break resolution itself, only who's allowed to
# ask.
server:
  # Deny everyone by default...
  access-control: 0.0.0.0/0 refuse
  access-control: ::0/0 refuse
  # ...except sieve, Unbound's only intended client.
  access-control: ${SIEVE_LAN_IP}/32 allow
