# Named local.env.example (not .env.local.example) — same device-bridge
# write-guard workaround as stacks/sieve/local.env.example (anything
# matching *.env.local* gets blocked, even a harmless placeholder).
#
# Copy this file to .env.local (already covered by this repo's
# `*.env.local` .gitignore rule — never commit the real one) and fill in
# real values. Shared by every app in this stack via ./compose.sh and
# render-configs.sh.

SILO_LAN_IP=REPLACE_ME
TZ=Asia/Kolkata
# Same real domain as stacks/sieve/local.env.example's DOMAIN. Needed here
# as of 2026-08-31, for homepage/config/services.yaml.template's links to
# sieve's existing services (pihole.${DOMAIN} etc.) — not for anything else
# on silo yet. No app on silo is itself routed through Traefik/a public
# hostname.
DOMAIN=REPLACE_ME.example.com
# sieve's LAN IP — not a secret, but not hardcoded here either (decided
# 2026-08-31 — a cross-node fact like this belongs confirmed at setup
# time, not silently trusted from whatever an example file happened to
# say, which could go stale if sieve's address ever changes). Needed here
# so unbound/config/access-control.conf.template can restrict the
# resolver to sieve specifically, its only intended client — confirm it
# matches stacks/sieve/.env.local's own SIEVE_LAN_IP exactly.
SIEVE_LAN_IP=REPLACE_ME
# For netalertx/docker-compose.yml's SCAN_SUBNETS — needed 2026-09-01.
# Deliberately not guessed/hardcoded (e.g. to eth0 or 192.168.0.0/24):
# NetAlertX runs fine with a wrong value here — no error, no crash — and
# just silently scans nothing, a real failure mode other users have hit
# (github.com/jokob-sk/NetAlertX#770). Get the real interface name by
# running this ON silo (not in any container):
#   ip -o link show | awk -F': ' '!/lo|vir|docker/ {print $2}'
SILO_LAN_INTERFACE=REPLACE_ME
# CIDR notation, e.g. 192.168.0.0/24 — the actual LAN subnet to scan, not
# just SILO_LAN_IP's own /32. Same host/netmask as SILO_LAN_IP normally,
# but kept as its own explicit value rather than derived, since silo's
# actual netmask isn't something this repo can assume.
SILO_LAN_SUBNET=REPLACE_ME
# scrutiny/docker-compose.yml's devices: list -- the physical disk device
# node for S.M.A.R.T. monitoring (e.g. /dev/sda; for NVMe use the
# controller node /dev/nvme0, not the namespace block device
# /dev/nvme0n1). Not a secret, but genuinely per-node and not something
# to guess -- same reasoning as SIEVE_LAN_IP above. Find it with:
#   lsblk -d -o NAME,TYPE,SIZE,MODEL
# One line per real physical disk, not partitions. If silo only has one
# disk, that's the one to use.
SCRUTINY_DISK_DEVICE=REPLACE_ME
