# Rendered by render-configs.sh from *.template files, and generated by
# generate-secrets.sh — both contain the real domain and/or real secrets.
# The *.template / *.example files are the tracked source of truth; these
# are always regeneratable, never hand-edit them directly.
.env.local
*/secrets.env.local
*/config/*
!*/config/*.template
*/custom-dns/*
!*/custom-dns/*.template
