## Rendered by ../../render-configs.sh from this .template — edit the
## .template, never the rendered config.yaml (it gets overwritten).
## Trimmed to essentials — see https://headscale.net for the full option
## reference if you need DERP, OIDC, or ACL policy support later.

server_url: https://headscale.${DOMAIN}
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 0.0.0.0:50443
grpc_allow_insecure: false

private_key_path: /var/lib/headscale/private.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key

# The IP ranges headscale hands out to devices as they join the tailnet —
# NOT optional despite being absent from the first version of this file
# (added 2026-08-30 after headscale refused to start at all: "no IPv4 or
# IPv6 prefix configured, minimum one prefix is required"). These are
# headscale's own documented defaults, same ranges Tailscale's own hosted
# control plane uses: 100.64.0.0/10 is a CGNAT range reserved for exactly
# this (carrier-grade NAT / shared address space, RFC 6598) so it won't
# collide with your real LAN's 192.168.0.0/24, and fd7a:115c:a1e0::/48 is
# headscale's fixed ULA (unique local address) v6 prefix. No reason to
# change either unless you already have another Tailscale/headscale
# network on the same devices that also uses these ranges.
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 24h

dns:
  magic_dns: true
  base_domain: ts.${DOMAIN}
  nameservers:
    global:
      - 1.1.1.1
      - 1.0.0.1

# OIDC -- authenticates NODE ENROLLMENT ("tailscale up" login) against
# Authelia, added 2026-09-06. This is NOT a web admin UI login (headscale
# has none of its own) -- it only affects how a device joins the tailnet;
# nodes already enrolled via pre-auth key are completely unaffected.
# pkce.enabled defaults to false in headscale itself -- must be turned on
# here to match the require_pkce: true set on this client in
# authelia/config/configuration.yml.template, or the OIDC handshake fails.
oidc:
  only_start_if_oidc_is_available: false
  # false, not headscale's own suggested true -- true means this ENTIRE
  # daemon refuses to start at all if Authelia is unreachable at boot,
  # which would take down every already-enrolled node's coordination
  # server over an Authelia hiccup, not just block new enrollments.
  # Already-joined nodes don't re-contact the IdP until their session
  # expires or someone forces re-auth, so there's little upside to the
  # stricter setting here -- confirmed via headscale's own OIDC reference
  # docs (headscale.net/stable/ref/oidc/).
  issuer: "https://authelia.${DOMAIN}"
  client_id: "headscale"
  # Plaintext, not a file path -- unlike Authelia's client_secret
  # (a PBKDF2 hash full of literal $ characters, which envsubst would
  # mangle), this is a plain random string with no special characters,
  # so the normal ${VAR}-from-secrets.env.local pattern is safe here.
  client_secret: '${HEADSCALE_OIDC_CLIENT_SECRET}'
  scope: ["openid", "profile", "email", "groups"]
  pkce:
    enabled: true
    method: "S256"
  # Uncomment and edit once you've decided who should be allowed to
  # enroll a NEW device -- omitted for now so existing pre-auth-key-based
  # enrollment isn't accidentally narrowed by an empty/wrong filter.
  # Confirmed limitation from headscale's own docs: these groups/users
  # gate enrollment only, they can't be referenced inside headscale's own
  # ACL/grants policy language.
  # allowed_groups:
  #   - "headscale_users"

log:
  level: info
